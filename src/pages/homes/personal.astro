---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Curriculum Online - Kevin Falcones',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
   <Header
   links={[
      { text: 'Sobre mí', href: '#about' },
      { text: 'Experiencia', href: '#resume' },
      { text: 'Educación', href: '#education' },
      { text: 'Certificaciones', href: '#certifications' },
      { text: 'Proyectos', href: '#projects' },
      { text: 'Referencias', href: '#references' },
      { text: 'GitHub', href: 'https://github.com/KevinFalcones', target: '_blank' },
    ]}
    actions={[
      {
        text: 'Contrátame',
        href: 'mailto:johvin73@gmail.com',
        target: '_blank',
      },
    ]}
    isSticky
    showToggleTheme
  />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Kevin Falcones"
    tagline="Curriculum Online"
    actions={[{ variant: 'primary', text: 'Contrátame', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      Ingeniero en Sistemas y MBA con Especialidad en Trasformación Digital. <br /> Con más de 15 años de 
      certificada experiencia nacional e internacional en diversas áreas tecnológicas de empresas bancarias, 
      telecomunicacionales, comerciales y públicas. <br /> Estoy determinado a superar los retos profesionales 
      indistintamente de la tecnología, lenguaje, equipo de trabajo, proyecto, cargo o presión laboral.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'LinkedIn',
          href: 'https://www.linkedin.com/in/kevinfalcones/',
        },
      },
      {
        icon: 'tabler:brand-facebook',
        callToAction: {
          target: '_blank',
          text: 'Facebook',
          href: 'https://www.facebook.com/KevinFalconesOficial',
        },
      },
      {
        icon: 'tabler:brand-youtube',
        callToAction: {
          target: '_blank',
          text: 'YouTube',
          href: 'https://www.youtube.com/@kevinfalconesoficial',
        },
      },
    ]}
    image={{
      //src: 'https://images.unsplash.com/photo-1491349174775-aaafddd81942?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      src: '~/assets/images/KevinFalconesPortada.png',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Sobre mí</h2>
      <p>
        Mi compromiso es aportar soluciones robustas en automatización, transformación digital y cumplimiento de proyectos complejos,
         siempre con el objetivo de generar un valor diferencial que trascienda lo tecnológico y conecte 
         directamente con las necesidades del cliente.
      </p>
      <br />
      <p>
        Mi día a día es un equilibrio constante entre mi pasión por la innovación digital y mi vocación de servicio a la comunidad,
         la música y la comunicación, compartiendo este viaje en mis plataformas digitales para inspirar a otros 
         a integrar sus pasiones con su profesión.
      </p>
      <br />
      <p>
        Te invito a explorar mis redes sociales y mi canal de YouTube, espacios donde no solo verás al ingeniero, 
        sino también al hombre de fe, al músico y al comunicador que busca dejar una huella positiva y con propósito en la sociedad.
       ¡Conectemos!
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->
  <div class="mb-6">
    <a
      href="/cv.pdf"
      download="CV_KevinFalcones_DevOps.pdf"
      target="_blank"
      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm"
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
